{
  "name": "buildr",
  "description": "An opinionated monorepo foundation for building modern full-stack TypeScript applications",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "release": "node tools/scripts/release.ts",
    "api": "vpr --filter api",
    "web": "vpr --filter web",
    "database": "vpr --filter database",
    "shared": "vpr --filter shared",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:migrate": "docker compose run --rm migrate"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.83.0",
    "changelogen": "^0.6.2",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  }
}
